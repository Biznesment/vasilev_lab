<?xml version='1.0' encoding='utf-8'?>
<widget id="ru.vasilev.lab" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Vasilev Lab</name>
    <description>
        Учебное Cordova-приложение: карусель текстовых сообщений, информация об устройстве,
        геолокация (watchPosition) и статус батареи.
    </description>
    <author email="dev@example.com" href="https://example.com">Vasilev Lab</author>
    <content src="index.html" />

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />
        <preference name="AndroidXEnabled" value="true" />
        <preference name="Orientation" value="portrait" />

    </platform>

    <preference name="SplashMaintainAspectRatio" value="true" />
</widget>
